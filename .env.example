# ---------------------------------------------------------------------------
# Google Sheets (Service Account)
# ---------------------------------------------------------------------------
GOOGLE_SERVICE_ACCOUNT_EMAIL=tu-service-account@tu-proyecto.iam.gserviceaccount.com
# Pega la llave completa. En local puedes usar \n literales; en Vercel pega
# el bloque con saltos de línea reales (el código normaliza ambos casos).
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIExampleKeyContentHere\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz1234567890abcdefg

# ---------------------------------------------------------------------------
# Correo (Resend)
# ---------------------------------------------------------------------------
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=citas@tu-dominio.com

# ---------------------------------------------------------------------------
# WhatsApp (placeholder — reemplaza por tu proveedor real)
# ---------------------------------------------------------------------------
WHATSAPP_API_URL=https://graph.facebook.com/v20.0/TU_PHONE_NUMBER_ID/messages
WHATSAPP_API_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Sesión del dashboard del médico (login real — ver src/utils/session.ts)
# ---------------------------------------------------------------------------
# REQUERIDA. Firma la cookie de sesión "id_medico_sesion" (HMAC-SHA256) que
# emite POST /api/auth/login. Sin esta variable, toda sesión se trata como
# inválida (falla "cerrado": redirige a /login en vez de dejar pasar sin
# firma). Genera un valor largo y aleatorio, ej.: `openssl rand -hex 32`.
# Nunca la reutilices entre entornos (dev/preview/production) ni la subas al
# repositorio — solo va en .env.local y en Vercel → Environment Variables.
SESSION_SECRET=

# ---------------------------------------------------------------------------
# Diagnóstico de conexión a Google Sheets (opcional)
# ---------------------------------------------------------------------------
# ⚠️ SOLO configura esto en Vercel de forma TEMPORAL mientras depuras un
# 401/403 en producción. Habilita GET /api/debug/estado-sheets?secret=... que
# revisa las variables de arriba directamente en ese entorno de Vercel (ver
# README.md → "Diagnóstico de conexión a Google Sheets"). Si esta variable no
# está definida, el endpoint responde 404 (deshabilitado) automáticamente.
# Usa un valor largo y aleatorio, y BÓRRALO de Vercel en cuanto termines.
DEBUG_SECRET=
